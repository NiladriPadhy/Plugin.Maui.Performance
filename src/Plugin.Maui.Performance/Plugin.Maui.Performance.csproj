<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

    <RootNamespace>Plugin.Maui.Performance</RootNamespace>
    <AssemblyName>Plugin.Maui.Performance</AssemblyName>
    <PackageId>Plugin.Maui.Performance</PackageId>
    <Title>Plugin.Maui.Performance</Title>
    <Description>Lightweight mobile performance profiler for .NET MAUI on iOS and Android. Trace named operations, auto-measure startup, pages, navigation, API latency, images, memory, UI rendering, and database work, and print a compact timing report.</Description>
    <PackageTags>maui;ios;android;performance;profiler;trace;startup;navigation;latency;memory;sqlite;plugin</PackageTags>
    <Authors>Niladri</Authors>
    <Company>NugetWorld</Company>
    <Copyright>Copyright © 2026 Niladri</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/NiladriPadhy/Plugin.Maui.Performance</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NiladriPadhy/Plugin.Maui.Performance</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.0.0</Version>
    <PackageReleaseNotes>Initial release. Lightweight MAUI performance profiler with named traces and automatic startup, page, navigation, API, image, memory, render, and database timings for iOS and Android.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plugin.Maui.Performance.Tests" />
  </ItemGroup>

</Project>
